# Example (do not commit real tfvars / secrets):
# project_id = "my-gcp-project"
# region     = "asia-northeast1"
# embedder   = "local"
# image      = "asia-northeast1-docker.pkg.dev/PROJECT/media-search-repo/media-search@sha256:..."
#
# Non-prod public experiment:
# allow_unauthenticated = true
#
# Production IAP lock (Gmail allowlist; no Workspace):
# allow_unauthenticated = false
# iap_members = [
#   "user:you@gmail.com",
# ]
#
# Personal projects (no Org): after apply, enable IAP once in Cloud Run Console
# so Google can attach a custom OAuth client. See docs/run-gcp-iap.md.
#
# Feature 013 — monthly budget alerts (alert-only; does NOT stop billing):
# billing_account     = "01XXXX-XXXXXX-XXXXXX"  # gcloud billing accounts list
# monthly_budget_usd  = 50
# budget_alert_email  = "you@gmail.com"
